package main

import "core:fmt"
import "shapes"

doubled :: proc!(x: Expr) -> Expr {
	return quote(2 * shapes.sq_area($x))
}

report :: proc(sq: ^shapes.Sq) -> f64 {
	shapes.grow(sq)
	return doubled!(sq)
}

main :: proc() {
	sq := shapes.Sq{2}
	cube := shapes.Cube{1}
	a, b: shapes.Shape = &sq, &cube
	list := []shapes.Shape{a, b}
	fmt.println(shapes.total(list), report(&sq), shapes.area(&cube))
}
