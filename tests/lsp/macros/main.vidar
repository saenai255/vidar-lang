package main

import "core:fmt"
import "core:strconv"

LIMIT :: 10

Pair :: struct { a, b: int }

Named :: interface { label }

label :: proc(n: Named) -> string ---

pair_label :: proc(p: ^Pair) -> string { return "pair" }

impl Named for Pair { label = pair_label }

fib :: proc!(n: int) -> int {
	return n if n < 2 else fib(n - 1) + fib(n - 2)
}

double :: proc!(x: Expr(int)) -> Expr(int) {
	return quote($x * 2)
}

swap :: proc!(a, b: Expr) -> Stmt {
	return quote {
		tmp := $a
		$a = $b
		$b = tmp
	}
}

describe :: proc!(T: Type) -> Expr(string) {
	name := type_name(T)
	return quote($name)
}

declare :: proc!(name: Ident, value: int) -> Stmt {
	return quote { $name := $value }
}

parse :: proc(s: string) -> (value: int, ok: bool) {
	value, ok = strconv.parse_int(s)
	return
}

main :: proc() {
	small := fib!(LIMIT)
	table := comptime! {
		total := 0
		for i in 0..<LIMIT do total += i
		take total
	}
	x, y := 1, 2
	swap!(x, y)
	check!(x > y)
	declare!(made, 3)
	n := parse("7") catch err {
		fmt.println("bad", err)
		return
	}
	scoped! {
		words := double!(n)
		fmt.println(words, made)
	}
	p := Pair{1, 2}
	fmt.println(small, table, describe!(Pair), label(&p))
}
