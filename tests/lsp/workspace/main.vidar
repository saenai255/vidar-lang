package main

import "core:fmt"
import "geo"

Shape :: interface { area }

area :: proc(s: Shape) -> f64 ---

Sq :: struct { s: f64 }

sq_area :: proc(q: ^Sq) -> f64 { return q.s * q.s }

impl Shape for Sq { area = sq_area }

twice :: comptime proc(x: Expr(int)) -> Expr(int) { return quote($x * 2) }

main :: proc() {
	v := geo.add({1, 2}, {3, 4})
	count := 0
	inc := proc[&count]() { count += 1 }
	inc()
	sq := Sq{2}
	s: Shape = &sq
	box := { size = 2, label = "box" }
	_ = box.size + len(box.label)
	fmt.println(v.x, count, area(s), twice!(count))
}
