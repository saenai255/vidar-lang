package main; import __vidar "vidar_runtime"

import "core:fmt"

// an assignment whose new value moves the old one out: the new value is made first, so the old one
// is found zero and nothing is destroyed twice
R :: struct { id: int }
r_destroy :: proc(r: ^R) { if r.id != 0 do fmt.println("drop", r.id) }


bump :: proc( r: R) -> R { r := r; defer r_destroy(&r);
	out := R{r.id + 1}; defer r_destroy(&out)
	{ defer out = {}; return out }
}
same :: proc( r: R) -> R { r := r; defer r_destroy(&r); { defer r = {}; return r } }
peek :: proc(r: ^R) -> R { return R{r.id * 10} }

Holder :: struct { r: R }

main :: proc() {
	r := R{1}; defer r_destroy(&r)
	// move!(r) — input.vidar:22
	// move!(r) — input.vidar:22
	{ __vidar_new: type_of(r) = same(__vidar.take(&r)); __vidar_old := r; r = __vidar_new; r_destroy(&__vidar_old) }
	fmt.println("r", r.id)
	// move!(r) — input.vidar:24
	// move!(r) — input.vidar:24
	{ __vidar_new: type_of(r) = bump(__vidar.take(&r)); __vidar_old := r; r = __vidar_new; r_destroy(&__vidar_old) }
	fmt.println("r", r.id)
	// move!(r) — input.vidar:26
	// move!(r) — input.vidar:26
	{ __vidar_new: type_of(r) = __vidar.take(&r); __vidar_old := r; r = __vidar_new; r_destroy(&__vidar_old) }
	fmt.println("r", r.id)
	{ __vidar_new: type_of(r) = peek(&r); __vidar_old := r; r = __vidar_new; r_destroy(&__vidar_old) }
	fmt.println("r", r.id)
	h := Holder{R{5}}; defer __Holder_destroy(&h)
	p := &h
	// move!(p.r) — input.vidar:32
	// move!(p.r) — input.vidar:32
	{ __vidar_new: type_of(p.r) = same(__vidar.take(&p.r)); __vidar_old := p.r; p.r = __vidar_new; r_destroy(&__vidar_old) }
	fmt.println("h", h.r.id)
}

// ---- generated by vidar ----

// destroys a Holder: its fields that need it, last first
__Holder_destroy :: proc(x: ^Holder) {
	r_destroy(&x.r)
}

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(R, r_destroy)
	__vidar.register_destroy(Holder, __Holder_destroy)
}
