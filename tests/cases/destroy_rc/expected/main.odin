package main; import __vidar "vidar_runtime"

import "core:fmt"
import rc "vidar_rc"
import lib "lib"

File :: struct { name: string }
file_destroy :: proc(f: ^File) { if f.name != "" do fmt.println("close", f.name) }


open :: proc(name: string) -> File { return File{name} }

// impl Destroy for every instance of a parametric type, run before its fields are destroyed
Box :: struct($T: typeid) { v: ^T, log: File }
box_destroy :: proc(b: ^Box($T)) {
	if b.v == nil do return
	fmt.println("free box of", b.v^)
	free(b.v)
}


Holder :: struct { file: rc.Rc(File), tag: int }

// a tree whose children point back with a Weak: the cycle is still destroyed
Node :: struct {
	file:     File,
	parent:   rc.Weak(Node),
	children: [dynamic]rc.Rc(Node),
}

weak_refs :: proc() {
	w: rc.Weak(File); defer rc.weak_release(&w)
	{
		r := rc.new(open("watched")); defer rc.release(&r)
		{ __vidar_old := w; w = rc.downgrade(r); rc.weak_release(&__vidar_old) }
		u := rc.upgrade(w); defer rc.release(&u)
		fmt.println("alive", rc.alive(w), "owners", rc.count(r), rc.get(u).name)
	}
	gone := rc.upgrade(w); defer rc.release(&gone)
	fmt.println("alive", rc.alive(w), "upgraded", rc.get(gone) != nil)
	root := rc.new(Node{file = open("root")}); defer rc.release(&root)
	child := rc.new(Node{file = open("child"), parent = rc.downgrade(root)}); defer rc.release(&child)
	// move!(child) — main.vidar:43
	append(&rc.get(root).children, __vidar.take(&child))
	#assert(type_of(rc.get(root).children[0]) != File && type_of(rc.get(root).children[0]) != Node, "main.vidar:44: this copies a value whose type has impl Destroy, and both copies would be destroyed"); kid := __vidar.clone(rc.get(root).children[0]); defer __vidar.destroy(&kid)
	up := rc.upgrade(rc.get(kid).parent); defer rc.release(&up)
	fmt.println("parent of", rc.get(kid).file.name, "is", rc.get(up).file.name)
}

main :: proc() {
	r := rc.new(open("shared")); defer rc.release(&r)
	{
		s := rc.share(r); defer rc.release(&s)
		fmt.println("owners", rc.count(r))
		h := Holder{rc.share(r), 1}; defer __Holder_destroy(&h)
		fmt.println("owners", rc.count(r))
		p := lib.dup(r); defer __vidar.destroy(&p)
		k := lib.keep(r); defer __vidar.destroy(&k)
		fmt.println("owners", rc.count(r))
	}
	fmt.println("owners", rc.count(r), rc.get(r).name)
	f := open("moved"); defer file_destroy(&f)
	// move!(f) — main.vidar:62
	t := rc.new(__vidar.take(&f)); defer rc.release(&t)
	fmt.println(rc.get(t).name, f.name == "")
	o := lib.take_over(open("taken")); defer __vidar.destroy(&o)
	fmt.println(o.name)
	b := Box(int){new_clone(42), open("box log")}; defer __Box_destroy(&b)
	nested := rc.new(rc.new(5)); defer rc.release(&nested)
	#assert(type_of(rc.get(nested)^) != File && type_of(rc.get(nested)^) != Node, "main.vidar:68: this copies a value whose type has impl Destroy, and both copies would be destroyed"); inner := __vidar.clone(rc.get(nested)^); defer __vidar.destroy(&inner)
	fmt.println("nested", rc.get(inner)^, rc.count(inner))
	empty: rc.Rc(File); defer rc.release(&empty)
	fmt.println("empty", rc.count(empty))
	weak_refs()
	fmt.println("end of main")
}

// ---- generated by vidar ----

// destroys a Box: its impl Destroy proc, then its fields that need it, last first
__Box_destroy :: proc(x: ^Box($T)) {
	box_destroy(x)
	file_destroy(&x.log)
}

// destroys a Holder: its fields that need it, last first
__Holder_destroy :: proc(x: ^Holder) {
	rc.release(&x.file)
}

// copies a Holder: clones its fields that need it
__Holder_clone :: proc(x: Holder) -> Holder {
	c := x
	c.file = rc.share(x.file)
	return c
}

// destroys a Node: its fields that need it, last first
__Node_destroy :: proc(x: ^Node) {
	__vidar.destroy(&x.children)
	rc.weak_release(&x.parent)
	file_destroy(&x.file)
}

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(File, file_destroy)
	__vidar.register_generic(#location().file_path, "Box")
	__vidar.register_clone(Holder, __Holder_destroy, __Holder_clone)
	__vidar.register_destroy(Node, __Node_destroy)
}
