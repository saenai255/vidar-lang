package main; import __vidar "vidar_runtime"

import "core:fmt"

// elements of an array literal given by index or enum value move in, or are cloned, like any other
File :: struct { name: string }
file_destroy :: proc(f: ^File) { if f.name != "" do fmt.println("close", f.name) }


Handle :: struct { id: int }
handle_destroy :: proc(h: ^Handle) { if h.id != 0 do fmt.println("release", h.id) }
handle_clone :: proc(h: Handle) -> Handle { fmt.println("clone", h.id); return Handle{h.id + 10} }



Side :: enum { Left, Right }

main :: proc() {
	a := File{"a"}; defer file_destroy(&a)
	// move!(a) — input.vidar:20
	files := [2]File{1 = __vidar.take(&a), 0 = File{"b"}}; defer __vidar.destroy(&files)
	fmt.println(files[0].name, files[1].name, a.name == "")
	h := Handle{1}; defer handle_destroy(&h)
	hs := [2]Handle{0 = handle_clone(h)}; defer __vidar.destroy(&hs)         // cloned: h is read below
	fmt.println(h.id, hs[0].id, hs[1].id)
	sides := [Side]Handle{.Left = Handle{}, .Right = __vidar.take(&h)}; defer __vidar.destroy(&sides) // h's last use: moved
	fmt.println(sides[.Right].id)
	more: [2]Handle; defer __vidar.destroy(&more)
	g := Handle{2}; defer handle_destroy(&g)
	{ __vidar_new: type_of(more) = {1 = __vidar.take(&g)}; __vidar_old := more; more = __vidar_new; __vidar.destroy(&__vidar_old) }
	fmt.println(more[1].id)
}

// ---- generated by vidar ----

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(File, file_destroy)
	__vidar.register_clone(Handle, handle_destroy, handle_clone)
}
