package main

import "core:fmt"

main :: proc() {
	// each iteration's `i` is a fresh variable: by-value captures see 0, 1, 2
	values: [dynamic]closure() -> int
	for i in 0..<3 {
		append(&values, proc[i]() -> int { return i })
	}
	for f in values do fmt.print(f(), "")
	fmt.println()

	// by-reference capture of a range variable boxes it per iteration
	refs: [dynamic]closure() -> int
	for x in ([]int{10, 20, 30}) {
		append(&refs, proc[&x]() -> int { x += 1; return x })
	}
	for f in refs do fmt.print(f(), f(), "")
	fmt.println()

	// one shared counter captured by reference from inside a while-style loop
	n := 0
	bump := proc[&n]() { n += 2 }
	for n < 7 do bump()
	fmt.println("n:", n)

	// C-style loop variable captured by reference is shared by all closures
	shared: [dynamic]closure() -> int
	for j := 0; j < 3; j += 1 {
		append(&shared, proc[&j]() -> int { return j })
	}
	for f in shared do fmt.print(f(), "")
	fmt.println()
}
