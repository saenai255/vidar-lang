package main; import __vidar "vidar_runtime"

import "core:fmt"

// closures returned through named results (and procs behind a directive) keep their type in `:=`

Ops :: struct { f: __vidar.Closure(proc(__vidar.Env, int) -> int), g: [2]__vidar.Closure(proc(__vidar.Env, int) -> int) }

make_closures :: #force_no_inline proc() -> (fs: [3]__vidar.Closure(proc(__vidar.Env, int) -> int)) {
	for i in 0..<len(fs) do fs[i] = __closure_0(i)
	return
}

plain :: proc() -> (fs: [2]__vidar.Closure(proc(__vidar.Env, int) -> int)) {
	fs[0] = __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, x: int) -> int { return x + 100 }}
	fs[1] = __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, x: int) -> int { return x + 200 }}
	return
}

unnamed :: #force_inline proc() -> [2]__vidar.Closure(proc(__vidar.Env, int) -> int) {
	return {__vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, y: int) -> int { return y / 2 }}, __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, y: int) -> int { return y % 3 }}}
}

sliced :: #force_no_inline proc() -> (fs: []__vidar.Closure(proc(__vidar.Env, int) -> int)) {
	fs = make([]__vidar.Closure(proc(__vidar.Env, int) -> int), 2)
	fs[0] = __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, y: int) -> int { return y + 1 }}
	fs[1] = __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, y: int) -> int { return y + 2 }}
	return
}

dyn :: #force_no_inline proc() -> (fs: [dynamic]__vidar.Closure(proc(__vidar.Env, int) -> int)) {
	append(&fs, __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, y: int) -> int { return y - 1 }})
	return
}

ops :: #force_no_inline proc() -> (o: Ops, ok: bool) {
	o.f = __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, y: int) -> int { return -y }}
	o.g[0] = __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, y: int) -> int { return y * y }}
	o.g[1] = __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, y: int) -> int { return y * y * y }}
	return o, true
}

main :: proc() {
	fs := make_closures()
	for f in fs do fmt.println("fixed:", f.call(f.env, 10))
	fmt.println("indexed:", fs[2].call(fs[2].env, 5))
	ps := plain()
	for f in ps do fmt.println("plain:", f.call(f.env, 10))
	us := unnamed()
	for f in us do fmt.println("unnamed:", f.call(f.env, 10))
	ss := sliced()
	defer delete(ss)
	for f in ss do fmt.println("slice:", f.call(f.env, 10))
	ds := dyn()
	defer delete(ds)
	for f in ds do fmt.println("dynamic:", f.call(f.env, 10))
	o, ok := ops()
	fmt.println("struct:", o.f.call(o.f.env, 3), o.g[0].call(o.g[0].env, 3), o.g[1].call(o.g[1].env, 3), ok)
	for g in o.g do fmt.println("struct array:", g.call(g.env, 2))
}

// ---- generated by vidar ----

__closure_0 :: proc(__c0: $T0) -> __vidar.Closure(proc(__vidar.Env, int) -> int) {
	__Caps :: struct {
		i: T0,
	}
	#assert(size_of(__Caps) <= __vidar.CLOSURE_ENV, "closure at input.vidar:10: its captures don't fit in VIDAR_CLOSURE_ENV bytes; capture a pointer, or build with -define:VIDAR_CLOSURE_ENV=<bytes>")
	__Env :: struct { using __caps: __Caps, __pad: [__vidar.CLOSURE_ENV - size_of(__Caps)]byte }
	return __vidar.Closure(proc(__vidar.Env, int) -> int){
		call = proc(__env_raw: __vidar.Env, y: int) -> int { __env := transmute(__Env)__env_raw; return y * (__env.i + 1) },
		env = transmute(__vidar.Env)__Env{__caps = {__c0}},
	}
}
