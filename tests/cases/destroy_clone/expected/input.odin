package main; import __vidar "vidar_runtime"

import "core:fmt"

// impl Clone: a copy of a Handle calls handle_clone, and each copy is destroyed
Handle :: struct { id: int, refs: ^int }

handle_destroy :: proc(h: ^Handle) {
	if h.refs == nil do return // the zero value
	h.refs^ -= 1
	fmt.println("release", h.id, "left", h.refs^)
}

handle_clone :: proc(h: Handle) -> Handle {
	if h.refs != nil do h.refs^ += 1
	return h // a type's own clone proc copies it as it is
}




// cloned field by field, since both fields can be
Pair :: struct { a: Handle, n: int, b: Handle }

// move-only: impl Destroy without impl Clone
File :: struct { name: string }
file_destroy :: proc(f: ^File) { if f.name != "" do fmt.println("close", f.name) }


open :: proc(name: string) -> File { return File{name} }

// an #owned parameter takes the value over: it is destroyed here unless it moves out
keep :: proc( f: File) -> File { f := f; defer file_destroy(&f); { defer f = {}; return f } }

store :: proc(dst: ^File, f: File) { f := f; defer file_destroy(&f);
	// move!(f) — input.vidar:36
	// move!(f) — input.vidar:36
	{ __vidar_new: type_of(dst^) = __vidar.take(&f); __vidar_old := dst^; dst^ = __vidar_new; file_destroy(&__vidar_old) }
}

consume :: proc( h: Handle) { h := h; defer handle_destroy(&h);
	fmt.println("consumed", h.id)
}

// a borrowed parameter is cloned when it is returned
same :: proc(h: Handle) -> Handle { return handle_clone(h) }

main :: proc() {
	refs := 1
	h := Handle{1, &refs}; defer handle_destroy(&h)
	{
		g := handle_clone(h); defer handle_destroy(&g)
		p := Pair{handle_clone(h), 7, __vidar.take(&g)}; defer __Pair_destroy(&p)     // g's last use: moved into p, not cloned
		fmt.println("refs", refs)
		q := __Pair_clone(p); defer __Pair_destroy(&q)                 // cloned field by field: p is read below
		fmt.println("refs", refs, q.n, p.n)
		{ __vidar_new: type_of(q.a) = handle_clone(h); __vidar_old := q.a; q.a = __vidar_new; handle_destroy(&__vidar_old) }
		fmt.println("refs", refs)
	}
	fmt.println("refs", refs)
	consume(handle_clone(h))            // a clone
	consume(same(h))      // a new value moves in
	fmt.println("refs", refs)
	arr := [2]Handle{handle_clone(h), handle_clone(h)}; defer __vidar.destroy(&arr)
	arr2 := __vidar.clone(arr); defer __vidar.destroy(&arr2)           // cloned element by element at run time (arr is read below)
	fmt.println("refs", refs, arr[0].id)

	f := open("a"); defer file_destroy(&f)
	// move!(f) — input.vidar:67
	k := keep(__vidar.take(&f)); defer file_destroy(&k)
	fmt.println("kept", k.name, "and f is zero:", f.name == "")
	slot: File; defer file_destroy(&slot)
	store(&slot, open("b"))
	fmt.println("slot", slot.name)
}

// ---- generated by vidar ----

// destroys a Pair: its fields that need it, last first
__Pair_destroy :: proc(x: ^Pair) {
	handle_destroy(&x.b)
	handle_destroy(&x.a)
}

// copies a Pair: clones its fields that need it
__Pair_clone :: proc(x: Pair) -> Pair {
	c := x
	c.a = handle_clone(x.a)
	c.b = handle_clone(x.b)
	return c
}

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_clone(Handle, handle_destroy, handle_clone)
	__vidar.register_destroy(File, file_destroy)
	__vidar.register_clone(Pair, __Pair_destroy, __Pair_clone)
}
