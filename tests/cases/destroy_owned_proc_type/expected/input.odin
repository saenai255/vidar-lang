package main; import __vidar "vidar_runtime"

import "core:fmt"

// a proc type can take a parameter #owned too: a proc stored as one must agree with it
File :: struct { name: string }
file_destroy :: proc(f: ^File) { if f.name != "" do fmt.println("close", f.name) }


consume :: proc( f: File) { f := f; defer file_destroy(&f); fmt.println("consumed", f.name) }
show :: proc(f: File) { fmt.println("show", f.name) }

Sink :: proc( f: File)

run :: proc(sink: Sink, f: File) { f := f; defer file_destroy(&f); // move!(f) — input.vidar:15
	sink(__vidar.take(&f)) }
look :: proc(use: proc(File), f: File) { use(f) }

main :: proc() {
	sink: proc( f: File) = consume
	a := File{"a"}; defer file_destroy(&a)
	// move!(a) — input.vidar:21
	sink(__vidar.take(&a))
	b := File{"b"}; defer file_destroy(&b)
	// move!(b) — input.vidar:23
	run(consume, __vidar.take(&b))
	c := File{"c"}; defer file_destroy(&c)
	look(show, c)
	fmt.println("end")
}

// ---- generated by vidar ----

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(File, file_destroy)
}
