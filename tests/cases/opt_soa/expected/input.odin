package main; import __vidar "vidar_runtime"

import "core:fmt"

Particle :: struct {
	x, y, vx, vy: f32,
	id:           int,
	alive:        bool,
}

Pair :: struct { a, b: int }

// loops here touch only some of the 6 fields: -opt makes these #soa
converted :: proc() {
	ps := make(#soa[dynamic]Particle)
	defer delete(ps)
	reserve(&ps, len(ps) + 10)
	for i in 0..<10 do append(&ps, Particle{vx = f32(i), vy = 1, id = i, alive = i % 3 != 0})
	reserve(&ps, 16)
	for _ in 0..<3 {
		for &p in ps {
			p.x += p.vx
			p.y += p.vy
		}
	}
	first := ps[0]
	ps[1] = first
	ps[2].alive = ps[2].id > 1 && ps[0] == first
	sum: f32
	alive := 0
	for p, i in ps {
		sum += p.x + p.y
		if p.alive do alive += i
	}
	__fmt_0(len(ps), cap(ps) >= 16, sum, alive, ps[3])

	grid: #soa[8]Particle
	for &g, i in grid do g.vx = f32(i) * 0.5
	for i in 0..<len(grid) do #no_bounds_check grid[i].x += grid[i].vx
	__fmt_1(grid[7].x, grid[3])

	__buf_buf: #soa[5]Particle; buf := __buf_buf[:]
	/* delete(buf): buf is on the stack */
	for i := 0; i < len(buf); i += 1 do #no_bounds_check buf[i].id = i * i
	total := 0
	for b in buf do total += b.id
	__fmt_2(total, buf[4])
	clear(&ps)
	__fmt_3(len(ps))

	typed: #soa[dynamic]Particle = make(#soa[dynamic]Particle, 0, 4)
	defer delete(typed)
	reserve(&typed, len(typed) + 4)
	for i in 0..<4 do append(&typed, Particle{x = f32(i), id = i})
	for &p in typed do p.x *= 3
	__fmt_4(len(typed), typed[3].x, typed[1])

	typed_slice: #soa[]Particle = make(#soa[]Particle, 2)
	defer delete(typed_slice)
	for &p in typed_slice do p.y += 1
	__fmt_5(typed_slice[1].y)
}

sum_x :: proc(ps: []Particle) -> (s: f32) {
	for p in ps do s += p.x
	return
}

make_some :: proc() -> [dynamic]Particle {
	out: [dynamic]Particle
	reserve(&out, len(out) + 3)
	for i in 0..<3 do append(&out, Particle{x = f32(i)})
	for &p in out do p.x *= 2
	return out
}

// each of these keeps its layout, and -opt-report says why
kept :: proc() {
	sliced := make([]Particle, 4)
	defer delete(sliced)
	for &p in sliced do p.x = 1
	__fmt_6(sum_x(sliced[:]))

	passed := make([]Particle, 4)
	defer delete(passed)
	for &p in passed do p.x = 2
	__fmt_7(sum_x(passed))

	addressed: [4]Particle
	for i in 0..<len(addressed) do #no_bounds_check addressed[i].x = f32(i)
	q := &addressed[2]
	q.x = 9
	__fmt_8(addressed[2].x)

	pairs: [4]Pair
	for &p, i in pairs do p.a = i
	__fmt_9(pairs[3])

	whole: [dynamic]Particle
	defer delete(whole)
	append(&whole, Particle{id = 7})
	for p in whole do __fmt_10(p)

	captured: [dynamic]Particle
	defer delete(captured)
	append(&captured, Particle{id = 1})
	for &p in captured do p.y = 3
	count := __closure_0(&captured)
	__fmt_11(count.call(count.env))

	by_ref := make([dynamic]Particle)
	defer delete(by_ref)
	append(&by_ref, Particle{x = 5})
	for &p in by_ref {
		p.x += 1
		copy := p
		__fmt_12(copy.x)
	}

	returned: [dynamic]Particle = make_some()
	defer delete(returned)
	__fmt_13(returned[2].x)

	reassigned: [dynamic]Particle
	reserve(&reassigned, len(reassigned) + 2)
	for i in 0..<2 do append(&reassigned, Particle{id = i})
	for &p in reassigned do p.id += 1
	delete(reassigned)
	reassigned = make([dynamic]Particle)
	__fmt_14(len(reassigned))
	delete(reassigned)
}

main :: proc() {
	converted()
	kept()
}

