	n += __vidar.w_float(w, x.y)
	__vidar.w_str(w, ", ")
	n += __vidar.w_str(w, "vx = ")
	n += __vidar.w_float(w, x.vx)
	__vidar.w_str(w, ", ")
	n += __vidar.w_str(w, "vy = ")
	n += __vidar.w_float(w, x.vy)
	__vidar.w_str(w, ", ")
	n += __vidar.w_str(w, "id = ")
	n += __vidar.w_v(w, x.id)
	__vidar.w_str(w, ", ")
	n += __vidar.w_str(w, "alive = ")
	n += __vidar.w_v(w, x.alive)
	n += __vidar.w_str(w, "}")
	return
}

