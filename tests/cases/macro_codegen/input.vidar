package main

import "core:fmt"

Color :: struct { r, g, b: u8 }

// constant folding at compile time
pow :: comptime proc(base, exp: int) -> int {
	r := 1
	for _ in 0..<exp { r *= base }
	return r
}

// generate one statement per field
print_fields :: comptime proc(T: Type, v: Expr) -> Stmt {
	out: [dynamic]Stmt
	for f in type_fields(T) {
		label := type_name(T) + "." + f + ":"
		append(&out, quote { fmt.println($label, $v.$(ident(f))) })
	}
	return quote { $out }
}

// build an expression from a list
sum_of :: comptime proc(n: int) -> Expr(int) {
	e := quote(0)
	for k in 1..=n { e = quote($e + $k) }
	return e
}

// generate a closure
scaler :: comptime proc(T: Type, k: int) -> Expr {
	return quote(proc[](x: $T) -> $T { return x * $k })
}

main :: proc() {
	fmt.println(pow!(2, 10))
	c := Color{255, 128, 0}
	print_fields!(Color, c)
	fmt.println(sum_of!(4))
	double := scaler!(f32, 2)
	fmt.println(double(1.25))
}
