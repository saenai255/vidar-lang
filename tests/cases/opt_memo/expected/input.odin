package main; import __vidar "vidar_runtime"

import "core:fmt"

// calls itself twice per call: memoized on its own, with a map since int has no small domain
__fib_memo_body :: proc(n: int, __memo: ^__fib_Memo) -> int {
	if n < 2 do return n
	return __fib_memo(n - 1, __memo) + __fib_memo(n - 2, __memo)
}

// two parameters
__paths_memo_body :: proc(r, c: int, __memo: ^__paths_Memo) -> int {
	if r == 0 || c == 0 do return 1
	return __paths_memo(r - 1, c, __memo) + __paths_memo(r, c - 1, __memo)
}

// a u8 parameter: an array table
__tri_memo_body :: proc(n: u8, __memo: ^__tri_Memo) -> u64 {
	if n < 3 do return u64(n)
	return __tri_memo(n - 1, __memo) + __tri_memo(n - 2, __memo) + __tri_memo(n - 3, __memo)
}

// by hand, a parameter that isn't an integer

__splits_memo_body :: proc(s: string, __memo: ^__splits_Memo) -> int {
	if len(s) < 2 do return 1
	return __splits_memo(s[1:], __memo) + __splits_memo(s[2:], __memo)
}

// opted out

slow_fib :: proc(n: int) -> int {
	if n < 2 do return n
	return slow_fib(n - 1) + slow_fib(n - 2)
}

// calls itself once: nothing to share
fact :: proc(n: int) -> int {
	return 1 if n <= 1 else n * fact(n - 1)
}

main :: proc() {
	__fmt_0(fib(27), paths(10, 10), tri(22))
	__fmt_0(splits("abcdefghijklmnopqrstuvwxyz0123456789"), slow_fib(20), fact(10))
}

// ---- generated by vidar ----

// fib with a memo table: made by the outer call, shared by the recursive ones, freed on return
__fib_Memo :: map[int]int

fib :: proc(n: int) -> int {
	__memo: __fib_Memo
	defer delete(__memo)
	return __fib_memo(n, &__memo)
}

__fib_memo :: proc(n: int, __memo: ^__fib_Memo) -> int {
	key := n
	if v, ok := __memo[key]; ok do return v
	r := __fib_memo_body(n, __memo)
	__memo[key] = r
	return r
}

// paths with a memo table: made by the outer call, shared by the recursive ones, freed on return
__paths_Memo :: map[__paths_Memo_Key]int
__paths_Memo_Key :: struct { r: int, c: int }

paths :: proc(r: int, c: int) -> int {
	__memo: __paths_Memo
	defer delete(__memo)
	return __paths_memo(r, c, &__memo)
}

__paths_memo :: proc(r: int, c: int, __memo: ^__paths_Memo) -> int {
	key := __paths_Memo_Key{r, c}
	if v, ok := __memo[key]; ok do return v
	r := __paths_memo_body(r, c, __memo)
	__memo[key] = r
	return r
}

// tri with a memo table: made by the outer call, shared by the recursive ones, freed on return
__tri_Memo :: struct { done: [256]bool, value: [256]u64 }

tri :: proc(n: u8) -> u64 {
	__memo: __tri_Memo
	return __tri_memo(n, &__memo)
}

__tri_memo :: proc(n: u8, __memo: ^__tri_Memo) -> u64 {
	key := int(n)
	#no_bounds_check if __memo.done[key] do return __memo.value[key]
	r := __tri_memo_body(n, __memo)
	#no_bounds_check __memo.done[key], __memo.value[key] = true, r
	return r
}

// splits with a memo table: made by the outer call, shared by the recursive ones, freed on return
__splits_Memo :: map[string]int

splits :: proc(s: string) -> int {
	__memo: __splits_Memo
	defer delete(__memo)
	return __splits_memo(s, &__memo)
}

__splits_memo :: proc(s: string, __memo: ^__splits_Memo) -> int {
	key := s
	if v, ok := __memo[key]; ok do return v
	r := __splits_memo_body(s, __memo)
	__memo[key] = r
	return r
}

// fmt.println
__fmt_0 :: proc(a0: $T0, a1: $T1, a2: $T2) -> (n: int) {
	buf: [1024]byte
	bw: __vidar.File_Writer
	w := __vidar.std_writer(&bw, buf[:], false)
	n += __vidar.w_v(w, a0)
	n += __vidar.w_str(w, " ")
	n += __vidar.w_v(w, a1)
	n += __vidar.w_str(w, " ")
	n += __vidar.w_v(w, a2)
	n += __vidar.w_str(w, "\n")
	__vidar.w_flush(w)
	return
}
