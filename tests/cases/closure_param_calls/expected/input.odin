package main; import __vidar "vidar_runtime"

import "core:fmt"

// called twice: one read of f.call on entry serves both
twice :: proc(x: int, f: __vidar.Closure(proc(__vidar.Env, int) -> int)) -> int { __f_call := f.call; return __f_call(f.env, __f_call(f.env, x)) }

// called in a loop, and passed on unchanged
sum_map :: proc(xs: []int, f: __vidar.Closure(proc(__vidar.Env, int) -> int)) -> (total: int) { __f_call := f.call;
	for x in xs do total += __f_call(f.env, x)
	total += twice(0, f)
	return
}

// captured by reference: f is a local copy then, and calls read it as it is
swap_and_call :: proc(f: __vidar.Closure(proc(__vidar.Env, int) -> int), g: __vidar.Closure(proc(__vidar.Env, int) -> int)) -> int { f := f; g := g;
	reset := __closure_0(&f, &g)
	a := f.call(f.env, 1)
	reset.call(reset.env)
	return a * 100 + f.call(f.env, 1)
}

// called from a nested closure, through a by-reference capture
compose_sum :: proc(xs: []int, f, g: __vidar.Closure(proc(__vidar.Env, int) -> int)) -> int { f := f; g := g;
	both := __closure_1(&f, &g)
	return sum_map(xs, both)
}

// a closure literal's own closure parameter

apply_with :: proc(xs: []int, f: __vidar.Closure(proc(__vidar.Env, int) -> int)) -> int {
	run := __vidar.Closure(proc(__vidar.Env, []int, __vidar.Closure(proc(__vidar.Env, int) -> int)) -> int){call = proc(__env_raw: __vidar.Env, ys: []int, h: __vidar.Closure(proc(__vidar.Env, int) -> int)) -> (n: int) { __h_call := h.call;
		for y in ys do n += __h_call(h.env, y)
		return
	}}
	return run.call(run.env, xs, f)
}

main :: proc() {
	k := 3
	add := __closure_2(k)
	dbl := __vidar.Closure(proc(__vidar.Env, int) -> int){call = proc(__env_raw: __vidar.Env, x: int) -> int { return x * 2 }}
	xs := []int{1, 2, 3}
	fmt.println(twice(1, add), twice(1, dbl))
	fmt.println(sum_map(xs, add), sum_map(xs, dbl))
	fmt.println(swap_and_call(add, dbl))
	fmt.println(compose_sum(xs, add, dbl), apply_with(xs, add))
	// a literal passed straight in
	fmt.println(sum_map(xs, __closure_3(k)))
}

// ---- generated by vidar ----

