	return __vidar.Closure(proc(__vidar.Env, int) -> int){
		call = proc(__env_raw: __vidar.Env, x: int) -> int { __env := transmute(__Env)__env_raw; return __env.g^.call(__env.g^.env, __env.f^.call(__env.f^.env, x)) },
		env = transmute(__vidar.Env)__Env{__caps = {__c0, __c1}},
	}
}

