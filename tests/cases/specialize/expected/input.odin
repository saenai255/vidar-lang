}

// yes_no(x) for every x, computed by vidar
@(rodata)
__yes_no_table := [2]string{
	"no", "yes",
}

__kind_name_table: [Kind]string

__kind_name_compute :: proc(k: Kind) -> string {
	switch k {
	case .Small: return "small"
	case .Big: return "big"
	}
	return "?"
}

// kind_name(x) for every x, computed once at startup
@(init)
__kind_name_fill :: proc "contextless" () {
	context = __vidar.default_context()
	for x in Kind do __kind_name_table[x] = __kind_name_compute(x)
}
