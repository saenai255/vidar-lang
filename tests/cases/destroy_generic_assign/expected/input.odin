package main; import __vidar "vidar_runtime"

import "core:fmt"

// generic code destroys the old value on assignment, through __vidar.destroy, which does nothing
// for a type that holds nothing to destroy
R :: struct { id: int }
r_destroy :: proc(r: ^R) { if r.id != 0 do fmt.println("drop", r.id) }

mk :: proc(i: int) -> R { return R{i} }
num :: proc(i: int) -> int { return i }

Stack :: struct($T: typeid) { items: [dynamic]T, top: T }

twice :: proc(f: proc(int) -> $T) {
	x := f(1); defer __vidar.destroy(&x)
	{ __vidar_new: type_of(x) = f(2); __vidar_old := x; x = __vidar_new; __vidar.destroy(&__vidar_old) }
	fmt.println("twice end")
}

put :: proc(s: ^Stack($T), v: T, w: T) { v := v; defer __vidar.destroy(&v); w := w; defer __vidar.destroy(&w);
	// move!(v) — input.vidar:22
	// move!(v) — input.vidar:22
	{ __vidar_new: type_of(s.items[0]) = __vidar.take(&v); __vidar_old := s.items[0]; s.items[0] = __vidar_new; __vidar.destroy(&__vidar_old) }
	// move!(w) — input.vidar:23
	// move!(w) — input.vidar:23
	{ __vidar_new: type_of(s.top) = __vidar.take(&w); __vidar_old := s.top; s.top = __vidar_new; __vidar.destroy(&__vidar_old) }
}

set :: proc(p: ^$T, v: T) { v := v; defer __vidar.destroy(&v); // move!(v) — input.vidar:26
	// move!(v) — input.vidar:26
	{ __vidar_new: type_of(p^) = __vidar.take(&v); __vidar_old := p^; p^ = __vidar_new; __vidar.destroy(&__vidar_old) } }

main :: proc() {
	twice(mk)
	twice(num)
	s: Stack(R); defer __vidar.destroy(&s)
	append(&s.items, R{10})
	{ __vidar_new: type_of(s.top) = R{11}; __vidar_old := s.top; s.top = __vidar_new; __vidar.destroy(&__vidar_old) }
	put(&s, R{12}, R{13})
	fmt.println("put", s.items[0].id, s.top.id)
	a := R{20}; defer r_destroy(&a)
	set(&a, R{21})
	n := 1
	set(&n, 2)
	fmt.println("end", a.id, n)
}

// ---- generated by vidar ----

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(R, r_destroy)
}
