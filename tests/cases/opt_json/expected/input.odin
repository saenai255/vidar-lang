		{id = 2, name = "", note = "has a note", r = '"', level = Level(7)},
	}
	m := json.marshal
	check :: proc(got, want: []byte, gerr, werr: json.Marshal_Error) {
		__fmt_0(string(got) == string(want) && gerr == werr ? "same" : "DIFFERENT", string(got))
