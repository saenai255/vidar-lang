		check(got, want, gerr, werr)
		delete(got)
		delete(want)
	}
	got, gerr := __json_marshal_arr2_main_Item(items[:])
	want, werr := m(items[:])
	check(got, want, gerr, werr)
	delete(got)
	delete(want)
	got2, gerr2 := json.marshal(Color.Green)
	want2, werr2 := m(Color.Green)
	check(got2, want2, gerr2, werr2)
	delete(got2)
	delete(want2)
	tm: Tagged
	got3, gerr3 := json.marshal(tm)
	want3, werr3 := m(tm)
	check(got3, want3, gerr3, werr3)
