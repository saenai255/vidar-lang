package main

import "core:fmt"

fib :: comptime proc(n: int) -> int {
	if n < 2 do return n
	return fib(n - 1) + fib(n - 2)
}

square :: proc(x: int) -> int {
	return x * x
}

Point :: struct { x, y: int }

N :: 6

main :: proc() {
	a := comptime fib(20)
	b := comptime square(N) + 1
	c := comptime fmt.tprintf("fib(%d) = %d", 10, fib(10))
	primes: [5]int = comptime first_primes(5)
	p: Point = comptime make_point(3)
	d := square(7)
	neg := comptime -N
	flags := comptime N > 3 && N < 10
	fmt.println(a, b, c, primes, p, d, neg, flags)
}

first_primes :: comptime proc(n: int) -> [dynamic]int {
	out: [dynamic]int
	for i := 2; len(out) < n; i += 1 {
		prime := true
		for j := 2; j * j <= i; j += 1 {
			if i % j == 0 {
				prime = false
				break
			}
		}
		if prime do append(&out, i)
	}
	return out
}

make_point :: comptime proc(v: int) -> Point {
	return {x = v, y = v * 2}
}
