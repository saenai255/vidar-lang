	n += __vidar.w_quoted(w, x.name)
	__vidar.w_str(w, ", ")
	n += __vidar.w_str(w, "children = ")
	n += __print_sl_main_Node(w, x.children)
	n += __vidar.w_str(w, "}")
	return
}

@(private="file")
__print_sl_main_Node :: proc(w: __vidar.Writer, x: []Node) -> (n: int) {
	if raw_data(x) == nil && len(x) > 0 {
		__vidar.w_str(w, "nil")
		return
	}
	n += __vidar.w_str(w, "[")
	for e, i in x {
		if i > 0 do n += __vidar.w_str(w, ", ")
		n += __print_main_Node(w, e)
	}
	n += __vidar.w_str(w, "]")
	return
}

@(private="file")
__printh_main_Node :: proc(w: __vidar.Writer, x: Node, indent: int) -> (n: int) {
	n += __vidar.w_str(w, "Node{")
	n += __vidar.w_str(w, "\n")
	n += __vidar.w_tabs(w, indent + 1)
	n += __vidar.w_str(w, "name = ")
	n += __vidar.w_quoted(w, x.name)
	n += __vidar.w_str(w, ",\n")
	n += __vidar.w_tabs(w, indent + 1)
	n += __vidar.w_str(w, "children = ")
	n += __printh_sl_main_Node(w, x.children, indent + 1)
	n += __vidar.w_str(w, ",\n")
	n += __vidar.w_tabs(w, indent)
	n += __vidar.w_str(w, "}")
	return
}

@(private="file")
__printh_sl_main_Node :: proc(w: __vidar.Writer, x: []Node, indent: int) -> (n: int) {
	if raw_data(x) == nil && len(x) > 0 {
		__vidar.w_str(w, "nil")
		return
	}
	n += __vidar.w_str(w, "[")
	if len(x) > 0 {
		n += __vidar.w_str(w, "\n")
		for e in x {
			n += __vidar.w_tabs(w, indent + 1)
			n += __printh_main_Node(w, e, indent + 1)
			n += __vidar.w_str(w, ",\n")
		}
		n += __vidar.w_tabs(w, indent)
	}
	n += __vidar.w_str(w, "]")
	return
}

@(private="file")
__print_main_Color :: proc(w: __vidar.Writer, x: Color) -> (n: int) {
	switch x {
	case .Red: n += __vidar.w_str(w, "Red")
	case .Green: n += __vidar.w_str(w, "Green")
	case .Blue: n += __vidar.w_str(w, "Blue")
	case: n += __vidar.w_spec(w, x, "%v")
	}
	return
}

@(private="file")
__print_arr2_main_Inner :: proc(w: __vidar.Writer, x: [2]Inner) -> (n: int) {
	n += __vidar.w_str(w, "[")
	for e, i in x {
		if i > 0 do n += __vidar.w_str(w, ", ")
		n += __print_main_Inner(w, e)
	}
	n += __vidar.w_str(w, "]")
	return
}

@(private="file")
__printh_arr0_main_Inner :: proc(w: __vidar.Writer, x: [0]Inner, indent: int) -> (n: int) {
	n += __vidar.w_str(w, "[")
	if len(x) > 0 {
		n += __vidar.w_str(w, "\n")
		for e in x {
			n += __vidar.w_tabs(w, indent + 1)
			n += __printh_main_Inner(w, e, indent + 1)
			n += __vidar.w_str(w, ",\n")
		}
		n += __vidar.w_tabs(w, indent)
	}
	n += __vidar.w_str(w, "]")
	return
}
