	buf: [1024]byte
	bw: __vidar.File_Writer
	w := __vidar.std_writer(&bw, buf[:], false)
	n += __vidar.w_str(w, "  errdefer ran for ")
	n += __vidar.w_v(w, a0)
	n += __vidar.w_str(w, " ")
	when T1 == Error { n += __print_main_Error(w, a1) } else { n += __vidar.w_spec(w, a1, "%v") }
	n += __vidar.w_str(w, "\n")
	__vidar.w_flush(w)
	return
}

