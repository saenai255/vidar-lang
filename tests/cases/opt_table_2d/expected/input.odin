package main; import __vidar "vidar_runtime"

import "core:fmt"

// two parameters with small domains, pure integer code with a loop: a 2D table, on its own
gcd_steps :: #force_inline proc(neg: bool, b: u8) -> int { return __gcd_steps_table[1 if neg else 0][b] }










// by hand, computed at compile time

mix :: #force_inline proc(a: i8, b: bool) -> int { return __mix_table[int(a) + 128][1 if b else 0] }



// by hand, filled at startup: a global variable can't be read at compile time
base := 10


digits :: #force_inline proc(a: i8, signed: bool) -> int { return __digits_table[int(a) + 128][1 if signed else 0] }





// u8 × u8 is 65536 results: too many to compute on its own
popsum :: proc(a, b: u8) -> int {
	n := 0
	for x := a ~ b; x != 0; x >>= 1 do n += int(x & 1)
	return n
}

main :: proc() {
	total := 0
	for b in 0..<256 do total += gcd_steps(b % 2 == 0, u8(b))
	__fmt_0(total, gcd_steps(true, 20), gcd_steps(false, 255))
	__fmt_0(mix(-128, true), mix(127, false), mix(5, true))
	__fmt_1(popsum(0xff, 0x0f))
	__fmt_0(digits(-128, true), digits(5, false), digits(42, true))
}

