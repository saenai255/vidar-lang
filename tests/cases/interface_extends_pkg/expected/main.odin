package main

import "core:fmt"
import shapes "shapes"

// Extends an interface from another package.
Solid :: struct { data: rawptr, __vtable: ^__Solid_VTable }
volume :: proc{__Solid_volume, cube_volume}

Cube :: struct { side: f64 }

cube_area   :: proc(c: ^Cube) -> f64 { return 6 * c.side * c.side }
cube_volume :: proc(c: ^Cube) -> f64 { return c.side * c.side * c.side }



main :: proc() {
	c := Cube{2}
	s: Solid = __Solid_from(&c)
	fmt.println(shapes.area(__Solid_as_shapes_Shape(s)), volume(s))
	list: [dynamic]shapes.Shape
	append(&list, __Solid_as_shapes_Shape(s))
	sq := shapes.Square{3}
	p: shapes.Polygon = shapes.__Polygon_from(&sq)
	append(&list, shapes.as_shape(p), shapes.__Polygon_as_Shape(p))
	fmt.println("total:", shapes.total(list[:]), shapes.sides(p))

	none: shapes.Shape
	no_solid: Solid
	fmt.println("nil:", none.__vtable == nil, list[0].__vtable != nil, no_solid.__vtable == nil, s.__vtable == nil)
}

// ---- generated by vidar ----

__Solid_VTable :: struct {
	__shapes_Shape: shapes.__Shape_VTable,
	volume: proc(self: Solid) -> f64,
}

__Solid_volume :: proc(s: Solid) -> f64 {
	if s.__vtable == &__Solid_vtable_Cube { return cube_volume(auto_cast s.data) }
	return s.__vtable.volume(s)
}

__Solid_as_shapes_Shape :: #force_inline proc(v: Solid) -> shapes.Shape { return {data = v.data, __vtable = &v.__vtable.__shapes_Shape} }

__Solid_identity :: #force_inline proc(v: Solid) -> Solid { return v }

__Solid_from :: proc{__Solid_from_Cube, __Solid_identity}

@(rodata)
__Solid_vtable_Cube := __Solid_VTable{
	__shapes_Shape = {
		area = proc(self: shapes.Shape) -> f64 { return cube_area((^Cube)(self.data)) },
	},
	volume = proc(self: Solid) -> f64 { return cube_volume((^Cube)(self.data)) },
}

__Solid_from_Cube :: proc(p: ^Cube) -> Solid { return {data = p, __vtable = &__Solid_vtable_Cube} }
