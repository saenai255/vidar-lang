package main; import __vidar "vidar_runtime"

import "core:fmt"

// a directive in front of a value (#force_inline, #partial) doesn't make it a temporary
R :: struct { id: int }
r_destroy :: proc(r: ^R) { if r.id != 0 do fmt.println("drop", r.id) }


Side :: enum { Left, Right }

inner :: proc(i: int) -> R { return R{i} }

main :: proc() {
	a := #force_inline inner(1); defer r_destroy(&a)
	sides := #partial [Side]R{.Right = R{2}}; defer __vidar.destroy(&sides)
	fmt.println(a.id, sides[.Right].id)
	{ __vidar_new: type_of(a) = #force_inline inner(3); __vidar_old := a; a = __vidar_new; r_destroy(&__vidar_old) }
	fmt.println(a.id)
}

// ---- generated by vidar ----

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(R, r_destroy)
}
