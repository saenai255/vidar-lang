package main; import __vidar "vidar_runtime"

import "core:fmt"

// A closure from a capture list and a body.
// fn :: proc!(captures: []Ident, body: Stmt) -> Expr — comptime, input.vidar:6

// A closure returning its body's value, typed with type_of_expr.
// fn_ret :: proc!(captures: []Ident, body: Expr) -> Expr — comptime, input.vidar:11

// Comptime code can count and walk the list.
// names :: proc!(xs: []Ident = {}) -> Expr — comptime, input.vidar:17

main :: proc() {
	a := 1
	b := 2
	// fn!({a, b}) { fmt.println(a, b) } — input.vidar:26
	show := __closure_0(a, b)
	show.call(show.env)

	// fn!({&a, &b}) { a += 10; b += 20 } — input.vidar:29
	bump := __closure_1(&a, &b)
	bump.call(bump.env)
	fmt.println(a, b)

	// fn!({a, &b}) { b += a } — input.vidar:33
	mixed := __closure_2(a, &b)
	mixed.call(mixed.env)
	fmt.println(b)

	// fn!({}) { fmt.println("no captures") } — input.vidar:37
	hello := __vidar.Closure(proc(__vidar.Env)){call = proc(__env_raw: __vidar.Env) {
		{
			fmt.println("no captures")
		}
	}}
	hello.call(hello.env)

	// fn_ret!({a, b}, a + b) — input.vidar:40
	total := __closure_3(a, b)     // untyped int: int
	// fn_ret!({a, b}, a > b) — input.vidar:41
	bigger := __closure_4(a, b)    // untyped bool: bool
	fmt.println(total.call(total.env), bigger.call(bigger.env))

	// names!({a, &b,}) — input.vidar:44
	fmt.println(fmt.tprintf("%d: %s", 2, "a &b "))
	// names!() — input.vidar:45
	fmt.println(fmt.tprintf("%d: %s", 0, ""))
}

