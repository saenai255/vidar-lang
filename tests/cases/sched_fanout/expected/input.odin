	#assert(size_of(__Caps) <= __vidar.CLOSURE_ENV, "closure at input.vidar:43: its captures don't fit in VIDAR_CLOSURE_ENV bytes; capture a pointer, or build with -define:VIDAR_CLOSURE_ENV=<bytes>")
