package main; import __vidar "vidar_runtime"

import "core:fmt"
import lib "lib"

File :: struct { name: string }

file_destroy :: proc(f: ^File) {
	if f.name == "" do return
	fmt.println("close", f.name)
}



open :: proc(name: string) -> File { return File{name} }

main :: proc() {
	// lib can't name File: its generic code finds the destructor at run time
	p := lib.make_pair(open); defer __vidar.destroy(&p)
	lib.scratch(open)
	f := open("borrowed"); defer file_destroy(&f)
	fmt.println("pair", p.a.name, p.b.name, lib.name_of(f))
	// with an int, nothing is destroyed or checked
	lib.scratch(proc(s: string) -> int { return len(s) })
	fmt.println(lib.first([]int{7, 8}))
}

// ---- generated by vidar ----

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(File, file_destroy)
}
