package main

import "core:fmt"
import "lib"

File :: struct { name: string }

file_destroy :: proc(f: ^File) {
	if f.name == "" do return
	fmt.println("close", f.name)
}

impl Destroy for File { destroy = file_destroy }

open :: proc(name: string) -> File { return File{name} }

main :: proc() {
	// lib can't name File: its generic code finds the destructor at run time
	p := lib.make_pair(open)
	lib.scratch(open)
	f := open("borrowed")
	fmt.println("pair", p.a.name, p.b.name, lib.name_of(f))
	// with an int, nothing is destroyed or checked
	lib.scratch(proc(s: string) -> int { return len(s) })
	fmt.println(lib.first([]int{7, 8}))
}
