package main; import __vidar "vidar_runtime"

import "core:fmt"

// a value returned along with an error is destroyed when or_return, or_else, or_break or
// or_continue drops it, and kept when the call succeeds
R :: struct { id: int }
r_destroy :: proc(r: ^R) { if r.id != 0 do fmt.println("drop", r.id) }


Err :: enum { None, Bad }

partial :: proc(i: int, fail: bool) -> (R, Err) { return R{i}, .Bad if fail else .None }
lookup :: proc(i: int, ok: bool) -> (R, bool) { return R{i}, ok }
both :: proc(i: int, fail: bool) -> (R, R, Err) { return R{i}, R{i + 1}, .Bad if fail else .None }
make_t :: proc(f: proc(int) -> $T, fail: bool) -> (T, Err) { return f(7), .Bad if fail else .None }
mk :: proc(i: int) -> R { return R{i} }

plain :: proc(fail: bool) -> Err {
	x := __vidar.drop_failed(partial(1, fail)) or_return; defer r_destroy(&x)
	fmt.println("plain kept", x.id)
	return nil
}

named :: proc(fail: bool) -> (r: R, e: Err) {
	{ __vidar_new: type_of(r) = __vidar.drop_failed(partial(2, fail)) or_return; __vidar_old := r; r = __vidar_new; r_destroy(&__vidar_old) }
	return
}

valued :: proc(fail: bool) -> Err {
	x, __err1 := __vidar.drop_failed(partial(3, fail)); if __vidar.failed(__err1) do return .Bad; defer r_destroy(&x)
	fmt.println("valued kept", x.id)
	return nil
}

ok_bool :: proc(ok: bool) -> bool {
	x := __vidar.drop_failed(lookup(4, ok)) or_return; defer r_destroy(&x)
	fmt.println("ok kept", x.id)
	return true
}

three :: proc(fail: bool) -> Err {
	a, b := __vidar.drop_failed3(both(5, fail)) or_return; defer r_destroy(&a); defer r_destroy(&b)
	fmt.println("three kept", a.id, b.id)
	return nil
}

generic :: proc(fail: bool) -> Err {
	x := __vidar.drop_failed(make_t(mk, fail)) or_return; defer __vidar.destroy(&x)
	fmt.println("generic kept", x.id)
	return nil
}

main :: proc() {
	plain(true)
	plain(false)
	{ r, e := named(true); defer r_destroy(&r) }
	valued(true)
	ok_bool(false)
	ok_bool(true)
	three(true)
	generic(true)
	y := __vidar.drop_failed(partial(8, true)) or_else R{9}; defer r_destroy(&y)
	fmt.println("or_else", y.id)
	for i in 0..<2 {
		z := __vidar.drop_failed(partial(10 + i, i == 1)) or_break; defer r_destroy(&z)
		fmt.println("loop", z.id)
	}
	fmt.println("end")
}

// ---- generated by vidar ----

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(R, r_destroy)
}
