	root := __vidar.Closure(proc(__vidar.Env) -> f64){call = proc(__env_raw: __vidar.Env) -> f64 {
		return math.sqrt(f64(2))
	}}          // proc group: the f64 member
	// fn!({s}, str.split(s, "")) — input.vidar:26
