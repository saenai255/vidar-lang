		return strconv.parse_int("42") or_else 0
	}}  // (int, bool) or_else: int
	fmt.println(upper.call(upper.env), first.call(first.env), letter.call(letter.env), root.call(root.env), parts.call(parts.env), num.call(num.env))

	// show!(math.PI) — input.vidar:30
	fmt.println("f64")                 // untyped float constant
	// show!(time.now()) — input.vidar:31
	fmt.println("time.Time")              // the package's own type, qualified
	// show!(str.builder_make()) — input.vidar:32
	fmt.println("str.Builder")      // a proc group of the package's own procs
}

