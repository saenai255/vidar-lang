package main

import "core:fmt"

main :: proc() {
	n := 1
	by_value := proc[n]() -> int { return n }
	by_ref := proc[&n]() -> int { return n }
	n = 2
	fmt.println(by_value(), by_ref())

	// state that changes lives behind a pointer; copies of the closure share it
	count := new_clone(n)
	counter := proc[count]() -> int { count^ += 1; return count^ }
	again := counter
	fmt.println(counter(), again(), count^, n)

	// params can be captured by reference too
	bump := proc(x: int) -> int {
		inc := proc[&x]() { x += 10 }
		inc()
		return x
	}
	fmt.println(bump(5))
}
