package main

import "core:fmt"

main :: proc() {
	n := 1
	by_value := proc[n]() -> int { return n }
	by_ref := proc[&n]() -> int { return n }
	n = 2
	fmt.println(by_value(), by_ref())

	// mutating a by-value capture changes only the closure's own copy
	counter := proc[n]() -> int { n += 1; return n }
	fmt.println(counter(), counter(), n)

	// params can be captured by reference too
	bump := proc(x: int) -> int {
		inc := proc[&x]() { x += 10 }
		inc()
		return x
	}
	fmt.println(bump(5))
}
