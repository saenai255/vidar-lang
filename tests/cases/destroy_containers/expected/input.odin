package main; import __vidar "vidar_runtime"

import "core:fmt"
import "core:strings"

File :: struct { name: string }
file_destroy :: proc(f: ^File) { if f.name != "" do fmt.println("close", f.name) }

open :: proc(name: string) -> File { return File{name} }

// cloneable: a copy is a clone, named with a '
Handle :: struct { name: string }
handle_destroy :: proc(h: ^Handle) {
	if h.name != "" do fmt.println("drop", h.name)
	delete(h.name)
}
handle_clone :: proc(h: Handle) -> Handle { return Handle{strings.concatenate({h.name, "'"})} }


handle :: proc(name: string) -> Handle { return Handle{strings.clone(name)} }

// a dynamic array field: destroyed with the Dir, and moved out with it
Dir :: struct {
	name:  string,
	files: [dynamic]File,
}

make_dir :: proc() -> Dir {
	d := Dir{name = "d"}; defer __Dir_destroy(&d)
	append(&d.files, open("d1"))
	append(&d.files, open("d2"))
	{ defer d = {}; return d }
}

// borrowed: the caller still owns the array
count :: proc(files: [dynamic]File) -> int { return len(files) }

// generic code: what it drops is destroyed when T needs it
Stack :: struct($T: typeid) { items: [dynamic]T }
push :: proc(s: ^Stack($T), x: T) { x := x; defer __vidar.destroy(&x); // move!(x) — input.vidar:40
	append(&s.items, __vidar.take(&x)) }
drop_top :: proc(s: ^Stack($T)) { __vidar.destroy_pop(&s.items) }
reset :: proc(s: ^Stack($T)) { __vidar.destroy_clear(&s.items) }

U :: union { Handle, int }

dynamic_arrays :: proc() {
	files: [dynamic]File; defer __vidar.destroy(&files)
	append(&files, open("a"))
	append(&files, open("b"), open("c"), open("d"), open("e"))
	f := open("f"); defer file_destroy(&f)
	// move!(f) — input.vidar:51
	append(&files, __vidar.take(&f))
	fmt.println("count", count(files))
	__vidar.destroy_ordered_remove(&files, 0)
	__vidar.destroy_unordered_remove(&files, 0)
	fmt.println("removed 2")
	__vidar.destroy_pop(&files)
	g := pop(&files); defer __vidar.destroy(&g)
	fmt.println("popped", g.name)
	{ __vidar_old := files[0]; files[0] = open("x"); file_destroy(&__vidar_old) }
	for &file in files do fmt.println("in array", file.name)
	__vidar.destroy_remove_range(&files, 0, 1)
	inject_at(&files, 0, open("y"))
	__vidar.destroy_resize(&files, 1)
	fmt.println("resized", len(files))
}

deletes :: proc() {
	files := make([dynamic]File); defer __vidar.destroy(&files)
	defer __vidar.destroy_delete(&files)
	append(&files, open("p"))
	__vidar.destroy_clear(&files)
	fmt.println("cleared")
	append(&files, open("q"))
}

maps :: proc() {
	m: map[string]File; defer __vidar.destroy(&m)
	{ __vidar_old := m["one"]; m["one"] = open("1"); file_destroy(&__vidar_old) }
	{ __vidar_old := m["one"]; m["one"] = open("1b"); file_destroy(&__vidar_old) }
	{ __vidar_old := m["two"]; m["two"] = open("2"); file_destroy(&__vidar_old) }
	__vidar.destroy_delete_key(&m, "two")
	for k, &v in m do fmt.println("in map", k, v.name)
	if p, ok := &m["one"]; ok do fmt.println("found", p.name)
	gone, f := delete_key(&m, "one"); defer __vidar.destroy(&gone); defer __vidar.destroy(&f)
	fmt.println("took", gone, f.name)
	{ __vidar_old := m["three"]; m["three"] = open("3"); file_destroy(&__vidar_old) }
	nested: map[string][dynamic]File; defer __vidar.destroy(&nested)
	list: [dynamic]File; defer __vidar.destroy(&list)
	append(&list, open("n1"), open("n2"))
	// move!(list) — input.vidar:90
	{ __vidar_old := nested["list"]; nested["list"] = __vidar.take(&list); __vidar.destroy(&__vidar_old) }
	fmt.println("end of maps")
}

clones :: proc() {
	a: [dynamic]Handle; defer __vidar.destroy(&a)
	append(&a, handle("a"), handle("b"))
	b := __vidar.clone(a); defer __vidar.destroy(&b)
	fmt.println("cloned", len(b), b[0].name, b[1].name)
	m: map[string]Handle; defer __vidar.destroy(&m)
	{ __vidar_old := m["k"]; m["k"] = handle("v"); handle_destroy(&__vidar_old) }
	v, ok := m["k"]; v = handle_clone(v); defer handle_destroy(&v)
	fmt.println("comma ok", v.name, ok)
	u: U = handle("u"); defer __vidar.destroy(&u)
	w, ok2 := u.(Handle); w = handle_clone(w); defer handle_destroy(&w)
	fmt.println("comma ok", w.name, ok2)
}

main :: proc() {
	dynamic_arrays()
	fmt.println("--- delete")
	deletes()
	fmt.println("--- maps")
	maps()
	fmt.println("--- dir")
	{
		d := make_dir(); defer __Dir_destroy(&d)
		fmt.println(d.name, len(d.files))
	}
	fmt.println("--- clones")
	clones()
	fmt.println("--- generic")
	{
		s: Stack(Handle); defer __vidar.destroy(&s)
		push(&s, handle("s1"))
		push(&s, handle("s2"))
		push(&s, handle("s3"))
		drop_top(&s)
		fmt.println(len(s.items))
		t: Stack(Handle); defer __vidar.destroy(&t)
		push(&t, handle("t1"))
		reset(&t)
		fmt.println(len(t.items))
	}
	fmt.println("done")
}

// ---- generated by vidar ----

// destroys a Dir: its fields that need it, last first
__Dir_destroy :: proc(x: ^Dir) {
	__vidar.destroy(&x.files)
}

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(File, file_destroy)
	__vidar.register_clone(Handle, handle_destroy, handle_clone)
	__vidar.register_destroy(Dir, __Dir_destroy)
}
