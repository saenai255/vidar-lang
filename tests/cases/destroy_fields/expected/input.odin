package main; import __vidar "vidar_runtime"

import "core:fmt"
import "core:strings"

File :: struct { name: string }

file_destroy :: proc(f: ^File) {
	if f.name == "" do return
	fmt.println("close", f.name)
}



open :: proc(name: string) -> File { return File{name} }

// no impl of its own: a Log is destroyed through its fields, last first
Log :: struct {
	out:   File,
	level: int,
	err:   File,
}

// an impl and fields: the impl runs first, then the fields
Server :: struct {
	name:  string,
	log:   Log,
	spare: [2]File,
	extra: Maybe(File),
}

server_destroy :: proc(s: ^Server) { fmt.println("stop", s.name) }



// a union holding a File destroys the variant it holds
Handle :: union { File, int }

make_log :: proc(tag: string) -> Log {
	// fresh values move into the literal
	l := Log{out = open(fmt.tprint(tag, "out")), err = open(fmt.tprint(tag, "err"))}; defer __Log_destroy(&l)
	{ defer l = {}; return l }
}

main :: proc() {
	fmt.println("-- fields")
	{
		l := make_log("l"); defer __Log_destroy(&l)
		l.level = 2
		fmt.println("level", l.level)
	}
	fmt.println("-- impl and fields")
	{
		s := Server{name = "s", log = make_log("s"), spare = {open("spare0"), open("spare1")}}; defer __Server_destroy(&s)
		{ __vidar_new: type_of(s.extra) = open("extra"); __vidar_old := s.extra; s.extra = __vidar_new; __vidar.destroy(&__vidar_old) }
	}
	fmt.println("-- array, Maybe, union")
	{
		arr := [2]File{open("a0"), open("a1")}; defer __vidar.destroy(&arr)
		m: Maybe(File) = open("maybe"); defer __vidar.destroy(&m)
		h: Handle = open("handle"); defer __vidar.destroy(&h)
		n: Handle = 5; defer __vidar.destroy(&n)
		none: Maybe(File); defer __vidar.destroy(&none)
	}
	fmt.println("-- a type vidar can't tell is destroyed at run time")
	{
		up := strings.to_upper("x", context.temp_allocator); defer __vidar.destroy(&up)
		k := abs(-3); defer __vidar.destroy(&k)
		fmt.println(up, k)
	}
	fmt.println("-- end")
}

// ---- generated by vidar ----

// destroys a Server: its impl Destroy proc, then its fields that need it, last first
__Server_destroy :: proc(x: ^Server) {
	server_destroy(x)
	__vidar.destroy(&x.extra)
	__vidar.destroy(&x.spare)
	__Log_destroy(&x.log)
}

// destroys a Log: its fields that need it, last first
__Log_destroy :: proc(x: ^Log) {
	file_destroy(&x.err)
	file_destroy(&x.out)
}

// impl Destroy for generic code and run-time checks
@(init, private="file")
__vidar_destroy_init :: proc "contextless" () {
	__vidar.register_destroy(File, file_destroy)
	__vidar.register_destroy(Server, __Server_destroy)
	__vidar.register_destroy(Log, __Log_destroy)
}
