package main; import __vidar "vidar_runtime"

import "core:fmt"

// impl Destroy: each local File is destroyed when its scope ends, in reverse order
File :: struct { name: string }

file_destroy :: proc(f: ^File) {
	if f.name == "" do return // a returned (moved) local is left zero
	fmt.println("close", f.name)
}





open :: proc(name: string) -> File {
	return File{name}
}

// a returned local moves out: only the other one is destroyed
pick :: proc(early: bool) -> File {
	a := open("a"); defer file_destroy(&a)
	if early { defer a = {}; return a }
	b := open("b"); defer file_destroy(&b)
	{ defer b = {}; return b }
}

// a parameter is borrowed: reading it is fine, and it isn't destroyed here
size :: proc(f: File) -> int { return len(f.name) }

main :: proc() {
	f := open("main"); defer file_destroy(&f)
	fmt.println("size", size(f))
	{
		g := open("inner"); defer file_destroy(&g)
		{ __vidar_new: type_of(g) = open("inner2"); __vidar_old := g; g = __vidar_new; file_destroy(&__vidar_old) } // the old value is destroyed
		fmt.println("in block", g.name)
	}
	x := pick(true); defer file_destroy(&x)
	y := pick(false); defer file_destroy(&y)
	fmt.println("picked", x.name, y.name)
	for i in 0..<2 { h := open(fmt.tprint("loop", i)); defer file_destroy(&h) }
	a, b := open("first"), open("second"); defer file_destroy(&a); defer file_destroy(&b)
	fmt.println(a.name, b.name)
	p := &a
	{ __vidar_new: type_of(p^) = open("through a pointer"); __vidar_old := p^; p^ = __vidar_new; file_destroy(&__vidar_old) }
	z: File; defer file_destroy(&z) // the zero value is destroyed too, so destroy must accept it
	{ __vidar_new: type_of(z) = open("late"); __vidar_old := z; z = __vidar_new; file_destroy(&__vidar_old) }
	count := 0
	bump := __closure_0(&z, &count)
	bump.call(bump.env)
	fmt.println("count", count)
	switch count {
	case 4:
		k := open("case"); defer file_destroy(&k)
		defer fmt.println("a user defer runs first:", k.name)
	}
	// scoped! { ... } — input.vidar:59
	{
		arena__1: __vidar.Temp_Arena
		context.temp_allocator = __vidar.temp_arena_begin(&arena__1, context.allocator)
		defer __vidar.temp_arena_end(&arena__1)
		{
			s := open("scoped"); defer file_destroy(&s)
			fmt.println("in scoped", s.name)
		}
	}
}

// ---- generated by vidar ----

__closure_0 :: proc(__c0: $T0, __c1: $T1) -> __vidar.Closure(proc(__vidar.Env)) {
	__Caps :: struct {
		z: T0,
		count: T1,
	}
	#assert(size_of(__Caps) <= __vidar.CLOSURE_ENV, "closure at input.vidar:51: its captures don't fit in VIDAR_CLOSURE_ENV bytes; capture a pointer, or build with -define:VIDAR_CLOSURE_ENV=<bytes>")
	__Env :: struct { using __caps: __Caps, __pad: [__vidar.CLOSURE_ENV - size_of(__Caps)]byte }
	return __vidar.Closure(proc(__vidar.Env)){
		call = proc(__env_raw: __vidar.Env) { __env := transmute(__Env)__env_raw; __env.count^ += len(__env.z^.name) },
		env = transmute(__vidar.Env)__Env{__caps = {__c0, __c1}},
	}
}
