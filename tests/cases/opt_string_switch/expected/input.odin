package main; import __vidar "vidar_runtime"

import "core:fmt"

Token :: enum { Ident, If, Else, For, In, Return, Proc, Struct, Enum, Switch, Case, Defer }

// 11 keywords: a perfect hash, then one compare
keyword :: proc(word: string) -> Token {
	switch __strswitch_0(word) {
	case 0:
		return .If
	case 1:
		return .Else
	case 2, 3:
		// two strings, one case
		return .For if word == "for" else .In
	case 4:
		return .Return
	case 5:
		return .Proc
	case 6:
		return .Struct
	case 7:
		return .Enum
	case 8:
		return .Switch
	case 9:
		return .Case
	case 10:
		return .Defer
	}
	return .Ident
}

// fallthrough, a default case in the middle, an init statement, and strings that share a length and bytes
kind :: proc(s: string) -> string {
	out := "?"
	switch t := s; __strswitch_1(t) {
	case 0:
		out = "aa"
		fallthrough
	case 1:
		out = out == "aa" ? "aa+ab" : "ab"
	case:
		out = "other"
	case 2, 3, 4, 5, 6, 7, 8, 9:
		out = __fmt_0(t)
	}
	return out
}

// same length, first, middle and last bytes: the cheap hash can't tell them apart, so FNV-1a it is
twins :: proc(s: string) -> int {
	switch __strswitch_2(s) {
	case 0: return 1
	case 1: return 2
	case 2: return 3
	case 3: return 4
	case 4: return 5
	case 5: return 6
	case 6: return 7
	case 7: return 8
	}
	return 0
}

// opted out

plain_twins :: proc(s: string) -> int {
	switch s {
	case "a1": return 1
	case "a2": return 2
	case "a3": return 3
	case "a4": return 4
	case "a5": return 5
	case "a6": return 6
	case "a7": return 7
	case "a8": return 8
	}
	return 0
}

// fewer than 8 strings: compared one after another
small :: proc(s: string) -> int {
	switch s {
	case "x": return 1
	case "y": return 2
	}
	return 0
}

main :: proc() {
	for w in ([]string{"if", "else", "for", "in", "return", "proc", "struct", "enum", "switch", "case", "defer", "iff", "", "x", "procs", "els"}) {
		__fmt_1(keyword(w))
	}
	__fmt_2()
	for s in ([]string{"aa", "ab", "ba", "bb", "ca", "cb", "a", "", "aaa", "é", "zz", "b"}) do __fmt_3(kind(s))
	__fmt_2()
	__fmt_4(small("y"), small("z"))
	__fmt_5(plain_twins("a7"))
	__fmt_6(twins("axbxa"), twins("asbsa"), twins("atbta"), twins("arbra"))
}

