// error: a Pool stores values: append q^ to copy it in
package main
Shape :: interface { area }
area :: proc(s: Shape) -> f64 ---
Sq :: struct { s: f64 }
sq_area :: proc(q: ^Sq) -> f64 { return 1 }
impl Shape for Sq { area = sq_area }
main :: proc() {
	p: Pool(Shape)
	q := new(Sq)
	append(&p, q)
}
