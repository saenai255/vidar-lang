// error: Pool(Shape) stores one array per implementing type, and can't for the impl for parametric type 'Box($T)'
package main
Shape :: interface { area }
area :: proc(s: Shape) -> f64 ---
Box :: struct($T: typeid) { v: T }
box_area :: proc(b: ^Box($T)) -> f64 { return f64(b.v) }
impl Shape for Box($T) { area = box_area }
main :: proc() {
	p: Pool(Shape)
	_ = p
}
