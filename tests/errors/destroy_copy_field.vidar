// error: 'log.out' is a File, which has impl Destroy, and 'f := log.out' would copy it
package main

import "core:fmt"

File :: struct { name: string }
file_destroy :: proc(f: ^File) { fmt.println("close", f.name) }
impl Destroy for File { destroy = file_destroy }

Log :: struct {
	out:   File,
	level: int,
}

main :: proc() {
	log := Log{out = File{"log"}}
	f := log.out
	fmt.println(f.name)
}
