{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vidar",
  "scopeName": "source.vidar",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#quote-splice"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#macro-call"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vidar",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vidar",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "meta.preprocessor.vidar",
          "match": "^\\s*#\\+.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vidar",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vidar",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.vidar",
          "begin": "`",
          "end": "`"
        },
        {
          "name": "string.quoted.single.vidar",
          "match": "'(\\\\.|[^'\\\\])*'"
        }
      ]
    },
    "quote-splice": {
      "patterns": [
        {
          "name": "variable.other.splice.vidar",
          "match": "\\$\\$|\\$[A-Za-z_]\\w*"
        },
        {
          "name": "keyword.other.quote.vidar",
          "match": "\\bquote(?=\\s*[({])"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*::\\s*(comptime\\s+proc)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.vidar"
            },
            "2": {
              "name": "storage.modifier.comptime.vidar"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*::\\s*(?:#\\w+\\s+)*(proc)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.vidar"
            },
            "2": {
              "name": "storage.type.proc.vidar"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*::\\s*(struct|union|enum|interface|distinct|bit_set|bit_field)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.vidar"
            },
            "2": {
              "name": "storage.type.vidar"
            }
          }
        },
        {
          "match": "^\\s*(impl)\\s+([A-Za-z_][\\w.]*)\\s+(for)\\s+([A-Za-z_][\\w.]*)",
          "captures": {
            "1": {
              "name": "keyword.other.impl.vidar"
            },
            "2": {
              "name": "entity.name.type.interface.vidar"
            },
            "3": {
              "name": "keyword.other.impl.vidar"
            },
            "4": {
              "name": "entity.name.type.vidar"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.error.vidar",
          "match": "\\bcatch\\b(\\s+unreachable\\b)?|^\\s*errdefer\\b"
        },
        {
          "name": "keyword.control.vidar",
          "match": "\\b(if|else|when|for|in|not_in|switch|case|break|continue|fallthrough|defer|return|do|or_else|or_return|or_break|or_continue|where)\\b"
        },
        {
          "name": "keyword.other.vidar",
          "match": "\\b(package|import|foreign|using|cast|transmute|auto_cast|context|asm)\\b"
        },
        {
          "name": "storage.type.vidar",
          "match": "\\b(proc|struct|union|enum|bit_set|bit_field|map|matrix|dynamic|distinct|typeid)\\b"
        },
        {
          "name": "storage.type.closure.vidar",
          "match": "\\b(closure|interface)\\b(?=\\s*[({])"
        },
        {
          "name": "storage.modifier.comptime.vidar",
          "match": "\\bcomptime\\b(?=\\s+proc)"
        },
        {
          "name": "constant.language.vidar",
          "match": "\\b(true|false|nil)\\b|---"
        }
      ]
    },
    "macro-call": {
      "match": "\\b([A-Za-z_]\\w*)(!)(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.macro.vidar"
        },
        "2": {
          "name": "keyword.operator.macro.vidar"
        }
      }
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.vidar",
          "match": "\\b(int|uint|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|uintptr|f16|f32|f64|bool|b8|b16|b32|b64|string|cstring|rune|rawptr|any|byte|complex64|complex128|quaternion256)\\b"
        },
        {
          "name": "support.type.macro.vidar",
          "match": "\\b(Expr|Stmt|Type|Ident)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.vidar",
      "match": "\\b(0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?[ijk]?)\\b"
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.other.directive.vidar",
          "match": "#[A-Za-z_]\\w*"
        },
        {
          "name": "storage.modifier.attribute.vidar",
          "match": "@\\(?[A-Za-z_][\\w=\", ]*\\)?"
        }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.vidar"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.vidar",
          "match": "->"
        },
        {
          "name": "keyword.operator.vidar",
          "match": "::|:=|\\.\\.[<=]|[-+*/%&|~^!<>=]=?|&&|\\|\\||<<|>>"
        }
      ]
    }
  }
}
