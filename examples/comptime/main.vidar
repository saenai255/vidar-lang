package main

import "core:fmt"

// `comptime expr` evaluates expr inside the transpiler and replaces it with the result.
// It can call comptime procs and regular procs, without `!`, and use macros.
// If expr cannot be evaluated at compile time, transpilation fails.

VERSION :: 3
TABLE_SIZE :: 16

fib :: comptime proc(n: int) -> int {
	return n if n < 2 else fib(n - 1) + fib(n - 2)
}

// A regular proc: callable at run time, and foldable when its arguments are constants.
square :: proc(x: int) -> int {
	return x * x
}

// Lookup tables are built once, in the transpiler; the output holds only the literal.
squares_table :: comptime proc(n: int) -> [dynamic]int {
	out: [dynamic]int
	for i in 0..<n do append(&out, i * i)
	return out
}

first_primes :: comptime proc(n: int) -> [dynamic]int {
	out: [dynamic]int
	for i := 2; len(out) < n; i += 1 {
		prime := true
		for p in out {
			if p * p > i do break
			if i % p == 0 {
				prime = false
				break
			}
		}
		if prime do append(&out, i)
	}
	return out
}

// Structs fold to compound literals.
Config :: struct {
	name:    string,
	workers: int,
	verbose: bool,
}

default_config :: comptime proc(workers: int) -> Config {
	return {name = fmt.tprintf("pool-%d", workers), workers = workers, verbose = workers > 4}
}

// A static assertion: folds to `true`, or stops compilation with a message.
static_assert :: comptime proc(ok: bool, msg: string) -> bool {
	if !ok do compile_error(msg)
	return true
}

// Strings: build banners, keys, tables of names...
banner :: comptime proc(title: string, width: int) -> string {
	pad := (width - len(title) - 2) / 2
	line := ""
	for _ in 0..<pad do line = line + "="
	return line + " " + title + " " + line
}

// A macro whose code result is evaluated when it is folded.
cube :: comptime proc(x: Expr) -> Expr {
	return quote($x * $x * $x)
}

main :: proc() {
	// Numbers
	f := comptime fib(25)
	area := comptime square(TABLE_SIZE) + 1
	mask := comptime (1 << 10) - 1

	// Strings
	version := comptime fmt.tprintf("v%d.%d", VERSION, fib(7))
	title := comptime banner("comptime", 24)

	// Arrays and structs: the target needs a known type
	squares: [TABLE_SIZE]int = comptime squares_table(TABLE_SIZE)
	primes: [8]int = comptime first_primes(8)
	cfg: Config = comptime default_config(8)

	// Assertions checked while transpiling
	_ = comptime static_assert(TABLE_SIZE & (TABLE_SIZE - 1) == 0, "TABLE_SIZE must be a power of two")

	// comptime do! { ... }: an inline compile-time block, no helper proc needed.
	// It folds to the value it returns; macros used inside it are folded too.
	month_starts: [12]int = comptime do! {
		days := [12]int{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
		starts: [dynamic]int
		total := 0
		for d in days {
			append(&starts, total)
			total += d
		}
		return starts
	}
	hex_digits := comptime do! {
		out := ""
		for i in 0..<16 do out = out + fmt.tprintf("%x", i)
		return out
	}
	sum_of_cubes := comptime do!(i64) {
		total := 0
		for i in 1..=TABLE_SIZE do total += cube!(i)
		return total
	}
	grade := comptime do! {
		score := fib(11) // 89
		return match!(score / 10) {
			10, 9 => "A",
			8 => "B",
			_ => "C",
		}
	}

	// Anything that depends on run-time values is a compile error, e.g.
	//     n := len(os.args)
	//     x := comptime square(n)    // error: 'n' is a runtime value ...

	fmt.println(title)
	fmt.println(f, area, mask, version)
	fmt.println(squares[TABLE_SIZE - 1], primes)
	fmt.println(cfg)
	fmt.println(month_starts, hex_digits, sum_of_cubes, grade)
}
