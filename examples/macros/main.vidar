package main

import "core:fmt"

// Comptime procs run inside the transpiler and are invoked with `name!(...)`.
// Expr(T) parameters must be expressions of type T at the call site.
square :: proc!(x: Expr(i32)) -> Expr(i32) {
	return quote($x * $x)
}

// Plain parameter types take compile-time constants; the result folds to a literal.
fib :: proc!(n: int) -> int {
	return n if n < 2 else fib(n - 1) + fib(n - 2)
}

// A statement macro. `tmp` is hygienic: it can't collide with the caller's names.
swap :: proc!(a, b: Expr) -> Stmt {
	return quote {
		tmp := $a
		$a = $b
		$b = tmp
	}
}

// A trailing Stmt parameter can be passed as a block after the call.
// Parameters can have defaults: code for Expr/Stmt/Type, constants otherwise.
repeat :: proc!(n: int = 2, body: Stmt) -> Stmt {
	out: [dynamic]Stmt
	for _ in 0..<n do append(&out, body)
	return quote { $out }
}

// stringify gives the source text of a code argument.
expect :: proc!(cond: Expr(bool)) -> Stmt {
	msg := "expectation failed: " + stringify(cond)
	return quote {
		if !$cond { fmt.println($msg) }
	}
}

// Type parameters and reflection: a printer for any struct.
show :: proc!(T: Type, value: Expr) -> Expr(string) {
	layout := type_name(T) + "{{"
	args: [dynamic]Expr
	for f, i in type_fields(T) {
		layout += fmt.tprintf("%s%s = %%v", "" if i == 0 else ", ", f)
		append(&args, quote($value.$(ident(f))))
	}
	layout += "}}"
	return quote(fmt.tprintf($layout, $args))
}

// type_of_expr gives the type of an argument, so the caller doesn't have to spell it.
zero_like :: proc!(x: Expr) -> Expr {
	T := type_of_expr(x)
	return quote($T{})
}

// Ident parameters splice unhygienically, so a macro can declare names on purpose.
define_twice :: proc!(name: Ident, value: int) -> Stmt {
	return quote { $name := $value * 2 }
}

// Macros can generate closures, and reject bad input with compile_error.
make_scaler :: proc!(T: Type, k: Expr) -> Expr {
	if type_name(T) == "string" do compile_error("make_scaler: cannot scale a string")
	return quote(proc[](x: $T) -> $T { return x * $k })
}

Point :: struct { x, y: i32 }

main :: proc() {
	k: i32 = 7
	fmt.println("square:", square!(k + 1))
	fmt.println("fib(20):", fib!(20))

	tmp, other := 1, 2
	swap!(tmp, other)
	fmt.println("swapped:", tmp, other)

	total := 0
	repeat!(4) { total += 10 }
	repeat! { total += 1 }
	fmt.println("repeated:", total)

	expect!(total == 42)
	expect!(total < 0)

	p := Point{3, -4}
	fmt.println(show!(Point, p))
	fmt.println("zero_like:", zero_like!(p))

	define_twice!(answer, 21)
	fmt.println("answer:", answer)

	triple := make_scaler!(f64, 3)
	fmt.println("scaled:", triple(1.5))
}
